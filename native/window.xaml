<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hub" Width="1100" Height="730" MinWidth="560" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{DynamicResource Ink}" Background="Transparent" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="43" ResizeBorderThickness="6" GlassFrameThickness="-1"
                        UseAeroCaptionButtons="False" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F0F6FF" />
    <SolidColorBrush x:Key="Muted" Color="#CBD9EA" />
    <SolidColorBrush x:Key="Tint" Color="#81101B2B" />
    <SolidColorBrush x:Key="Glass" Color="#A3233040" />
    <SolidColorBrush x:Key="Layer" Color="#F1222F40" />
    <SolidColorBrush x:Key="Field" Color="#CA141F2D" />
    <SolidColorBrush x:Key="Hover" Color="#6047678C" />
    <SolidColorBrush x:Key="Edge" Color="#709DC0E3" />
    <SolidColorBrush x:Key="Accent" Color="#B9E2FF" />
    <SolidColorBrush x:Key="AccentInk" Color="#122838" />
    <SolidColorBrush x:Key="Selected" Color="#8953769D" />
    <SolidColorBrush x:Key="Track" Color="#5E485C72" />
    <SolidColorBrush x:Key="Scrim" Color="#70091424" />
    <LinearGradientBrush x:Key="GlassRim" StartPoint=".67,0" EndPoint=".33,1">
      <GradientStop Color="#A8F1F8FF" />
      <GradientStop Color="#709DC0E3" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="ControlRadius">15</CornerRadius>
    <CornerRadius x:Key="FieldRadius">13</CornerRadius>
    <CornerRadius x:Key="PanelRadius">22</CornerRadius>
    <CornerRadius x:Key="RowRadius">10</CornerRadius>
    <Style x:Key="KeyboardFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-2" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    CornerRadius="{DynamicResource ControlRadius}" IsHitTestVisible="False" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style x:Key="WrappedContent" TargetType="ContentPresenter">
      <Style.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="AccessText">
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </Style.Resources>
    </Style>
    <Style TargetType="Button" x:Key="Control">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Glass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="33" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Surface" Background="Transparent">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" />
              <Border x:Name="Highlight" Margin="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}"
                      CornerRadius="{DynamicResource ControlRadius}" Opacity="0" />
              <ContentPresenter x:Name="Caption" Style="{StaticResource WrappedContent}"
                                Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value=".09" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Highlight" Property="Opacity" Value=".14" />
                <Setter TargetName="Caption" Property="Opacity" Value=".84" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value=".5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Control}" />
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Control}">
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource Control}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Field}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Selected}" />
      <Setter Property="SelectionOpacity" Value="1" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputRim" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FieldRadius}"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputRim" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputRim" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Field}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid x:Name="Picker">
              <Border x:Name="PickerRim" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FieldRadius}" />
              <Border x:Name="PickerHover" Background="{DynamicResource Hover}" CornerRadius="{DynamicResource FieldRadius}"
                      Opacity="0" Margin="1" />
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="SelectedChoice" Style="{StaticResource WrappedContent}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                VerticalAlignment="Center" Margin="10,3,32,3" IsHitTestVisible="False" />
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"
                       Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                       VerticalAlignment="Center" Margin="10,3,32,3" />
              <Path x:Name="Chevron" Data="M0 0 L4 4 L8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                    RenderTransformOrigin=".5,.5" IsHitTestVisible="False">
                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
              </Path>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="3">
                <Border Background="{DynamicResource Layer}" BorderBrush="{DynamicResource GlassRim}" BorderThickness="1"
                        CornerRadius="{DynamicResource PanelRadius}" Padding="5"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter x:Name="ItemsPresenter" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PickerHover" Property="Opacity" Value=".45" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PickerRim" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="SelectedChoice" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Picker" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource RowRadius}">
              <ContentPresenter Style="{StaticResource WrappedContent}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource Hover}" />
                <Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Choice" Property="Background" Value="{DynamicResource Selected}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Choice" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border x:Name="Rail" Background="{TemplateBinding Background}" CornerRadius="2"
                      Height="4" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Track}}" Value="Vertical">
                <Setter TargetName="Rail" Property="Height" Value="Auto" />
                <Setter TargetName="Rail" Property="Width" Value="4" />
                <Setter TargetName="Rail" Property="VerticalAlignment" Value="Stretch" />
                <Setter TargetName="Rail" Property="HorizontalAlignment" Value="Center" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageBack" Style="{StaticResource TrackButton}"
                              Background="{DynamicResource Track}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Border x:Name="Grip" Background="{DynamicResource Muted}" Opacity=".5" CornerRadius="4"
                                Width="5" HorizontalAlignment="Center" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                          <Setter TargetName="Grip" Property="Width" Value="Auto" />
                          <Setter TargetName="Grip" Property="Height" Value="5" />
                          <Setter TargetName="Grip" Property="HorizontalAlignment" Value="Stretch" />
                          <Setter TargetName="Grip" Property="VerticalAlignment" Value="Center" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Grip" Property="Opacity" Value=".85" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Grip" Property="Opacity" Value="1" />
                          <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageForward" Style="{StaticResource TrackButton}"
                              Background="{DynamicResource Track}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand" />
                <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid x:Name="SliderSurface" Background="Transparent">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackButton}" Background="{DynamicResource Accent}"
                                Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Ellipse x:Name="Halo" Fill="{DynamicResource Selected}" Opacity="0" />
                          <Ellipse Width="14" Height="14" Fill="{DynamicResource Accent}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Fill" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Halo" Property="Opacity" Value=".6" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource TrackButton}" Background="{DynamicResource Track}"
                                Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SliderSurface" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource Track}" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="Meter" ClipToBounds="True">
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                      HorizontalAlignment="Left" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter TargetName="Meter" Property="LayoutTransform">
                  <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="OpacityMask">
                  <Setter.Value>
                    <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,8,8"
                                  ViewboxUnits="Absolute" Viewbox="0,0,8,8">
                      <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="White" Geometry="M-8 8 L0 0 H4 L-4 8 Z M0 8 L8 0 H12 L4 8 Z" />
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="MinWidth" Value="6" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToggleChoice" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Margin" Value="0,5,0,6" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
    </Style>
    <Style x:Key="ToggleCaption" TargetType="ContentPresenter" BasedOn="{StaticResource WrappedContent}">
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="RecognizesAccessKey" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleChoice}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid x:Name="Check" Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource Field}" BorderBrush="{DynamicResource Muted}"
                      BorderThickness="1" CornerRadius="4">
                <Path x:Name="CheckMark" Data="M0 3 L3 6 L9 0" Stroke="{DynamicResource AccentInk}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Style="{StaticResource ToggleCaption}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="CheckMark" Property="Data" Value="M0 0 H8" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="Opacity" Value=".72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Check" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource ToggleChoice}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Radio" Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid x:Name="RadioMark" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="RadioRing" Stroke="{DynamicResource Muted}" Fill="{DynamicResource Field}" />
                <Ellipse x:Name="RadioDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Style="{StaticResource ToggleCaption}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RadioRing" Property="Fill" Value="{DynamicResource Hover}" />
                <Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RadioMark" Property="Opacity" Value=".72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Radio" Property="Opacity" Value=".55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Layer}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="{TemplateBinding Padding}">
              <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="{DynamicResource RowRadius}">
              <ContentPresenter Style="{StaticResource WrappedContent}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Tint}">
    <Grid x:Name="Shell">
      <Grid.RowDefinitions><RowDefinition Height="45" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="17,4,9,3" LastChildFill="False">
        <StackPanel x:Name="Brand" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" />
        <StackPanel x:Name="WindowActions" DockPanel.Dock="Right" Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" />
      </DockPanel>
      <Grid Grid.Row="1" Margin="12,0,12,12">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="215" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="NavigationRail" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource ChromeFill}"
                BorderBrush="{DynamicResource GlassRim}" BorderThickness="{DynamicResource PanelStroke}" Padding="7">
          <DockPanel>
            <StackPanel x:Name="NavFoot" DockPanel.Dock="Bottom" Margin="0,7,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="Nav" KeyboardNavigation.TabNavigation="Continue" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border x:Name="Reflection" CornerRadius="{DynamicResource PanelRadius}" IsHitTestVisible="False" Opacity="0">
          <Border.Background>
            <RadialGradientBrush RadiusX=".8" RadiusY=".25">
              <GradientStop Color="#18FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
          </Border.Background>
        </Border>
        <Grid Grid.Column="1" Margin="12,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel x:Name="TopBar" Orientation="Horizontal" Margin="4,0,0,12" />
          <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="5,2,10,5">
            <StackPanel x:Name="ContentPanel" />
          </ScrollViewer>
          <Border Grid.Row="2" CornerRadius="{DynamicResource RowRadius}" Background="{DynamicResource Glass}"
                  Padding="10,4" Margin="4,3,0,0">
            <TextBlock x:Name="Status" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource Scrim}"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Border x:Name="Palette" CornerRadius="{DynamicResource PanelRadius}" BorderThickness="1" BorderBrush="{DynamicResource GlassRim}"
              Background="{DynamicResource Layer}" Padding="18" MaxWidth="620" Margin="18,62,18,15"
              HorizontalAlignment="Stretch" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
          <TextBlock Text="Поиск по Hub" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBox x:Name="SearchInput" AutomationProperties.Name="Поиск по Hub" />
          <ListBox x:Name="SearchResults" Margin="0,10,0,0" MaxHeight="320" />
          <TextBlock Text="↑ ↓  Выбрать      Enter  Открыть      Esc  Закрыть" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
